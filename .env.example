# =============================================================================
# DecisionLedger — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# BREAKING in this revision: Postgres role/db default renamed
# `account_takeover` → `decisionledger`. Update local .env files; recreate
# the Postgres volume (`docker compose down -v`) so the new role initializes.
#
# Two namespaces:
#   - Unprefixed vars   → shared infrastructure (Postgres, Redis, ES, LLM
#                         keys, logging) consumed by FrameworkSettings in
#                         app/settings.py.
#   - <REASONER>_ vars  → reasoner-specific config consumed by that
#                         reasoner own Settings class. Today: ATO_ for
#                         the Account Takeover reasoner.
#
# Reasoners share Postgres, Redis, and Elasticsearch deployments. Tenant
# separation is logical (Postgres `reasoner_id` row filter, Redis key
# prefix, ES index per corpus) — not connection-level.
# =============================================================================

# --- LLM credentials (shared: gate + eval judges) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- PostgreSQL (shared; matches docker-compose.yml defaults) ---
POSTGRES_USER=decisionledger
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=decisionledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (shared; reasoners namespace by key prefix, e.g., `ato:*`) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Elasticsearch (shared; one cluster, one index per reasoner corpus) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Logging (process-wide) ---
LOG_JSON=true
LOG_LEVEL=INFO

# =============================================================================
# Account Takeover reasoner — ATO_-prefixed
# =============================================================================

# Path to the trained XGBoost model artifact. Built by `make train`.
ATO_SCORER_MODEL_PATH=reasoner/account_takeover/scorer/models/ato-v1.ubj

# Active policy corpus version recorded in every Decision Bundle. Update
# when ingesting a new corpus snapshot via the corpus loader.
ATO_CORPUS_VERSION=ato-v1
