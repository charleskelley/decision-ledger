# .envrc — project-local environment activation
# Run: direnv allow

# ─── Runtimes ────────────────────────────────────────────────────────────────
use mise

# ─── Python virtual environment ──────────────────────────────────────────────
layout uv

# ─── Project variables ───────────────────────────────────────────────────────
export PROJECT_NAME="$(basename "$PWD")"
export DATA_DIR="$PWD/data"
export OUTPUT_DIR="$PWD/outputs"
export MODEL_DIR="$PWD/models"

# ─── Experiment tracking (uncomment as needed) ────────────────────────────────
# export WANDB_PROJECT="$PROJECT_NAME"
# export MLFLOW_TRACKING_URI="http://localhost:5000"

# ─── Remote resources (GPU boxes) ────────────────────────────────────────────
# export CUDA_HOME="/usr/local/cuda"
# export NCCL_DEBUG=INFO

# ─── Secrets and local overrides (gitignored) ────────────────────────────────
# Project secrets live in .env (gitignored). The dotenv directive exports
# every KEY=VALUE pair into the shell so direct `uv run` / `make` calls
# see OPENAI_API_KEY and ANTHROPIC_API_KEY without manual sourcing.
# pydantic_settings (app/settings.py) also reads .env directly — direnv's
# export is for shell-level convenience, not the application's read path.
# See docs/operations/secrets.md for the full secrets-handling pattern.
[[ -f .env ]] && dotenv

# .envrc.local is for shell-level overrides that should not live in .env
# (custom aliases, GPU/CUDA exports, etc.). Sourced last so it can override.
[[ -f .envrc.local ]] && source_env .envrc.local
