# =============================================================================
# DecisionLedger — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# BREAKING in this revision: Postgres role/db default renamed
# `account_takeover` → `decisionledger`. Update local .env files; recreate
# the Postgres volume (`docker compose down -v`) so the new role initializes.
#
# Three namespaces:
#   - Unprefixed vars   → framework infrastructure (Postgres, ES, LLM keys,
#                         logging, reasoner composition) consumed by
#                         FrameworkSettings in app/settings.py.
#   - <REASONER>_ vars  → reasoner-specific config consumed by that
#                         reasoner's own Settings class. Today: ATO_ for
#                         the Account Takeover reasoner.
#   - <GATE>_ vars      → gate-specific config consumed by that gate's own
#                         Settings class. Today: RULES_GATE_ for the rules
#                         gate (gates/rules).
#
# Reasoners share the framework's Postgres and Elasticsearch deployments;
# tenant separation is logical (`reasoner_id` row filter in Postgres and on
# the shared ES index), not connection-level. Infrastructure a reasoner
# needs for itself (e.g. ATO's Redis feature state) is configured under
# that reasoner's prefix.
# =============================================================================

# --- LLM credentials (shared: gate + eval judges) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- PostgreSQL (shared; matches docker-compose.yml defaults) ---
POSTGRES_USER=decisionledger
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=decisionledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Elasticsearch (shared; one index, chunks tagged by reasoner_id) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Reasoner composition ---
# Comma-separated allowlist of reasoner ids to mount. Blank = every plugin
# discovered through the `decisionledger.reasoners` entry-point group.
DECISIONLEDGER_REASONERS=

# --- Logging (process-wide) ---
LOG_JSON=true
LOG_LEVEL=INFO

# =============================================================================
# Rules gate — RULES_GATE_-prefixed
# =============================================================================

# Directory of rule-set YAML files the rules gate registers at startup (one
# rule set per file; see gates/rules/README.md). Blank = no rule sets: every
# decision routed to the rules gate is held for review.
RULES_GATE_RULESETS_DIR=

# =============================================================================
# Account Takeover reasoner — ATO_-prefixed
# =============================================================================

# Redis used for ATO's sliding-window feature state and login-event stream.
ATO_REDIS_URL=redis://localhost:6379

# Host port for the redis service in reasoners/account_takeover/compose.yaml.
# ATO_REDIS_PORT=6379

# Path to the trained XGBoost model artifact. Built by `make train`.
# Optional: the default is the artifact shipped inside the reasoner package,
# resolved absolutely, so set this only to point at a different model.
# ATO_SCORER_MODEL_PATH=/abs/path/to/ato-v1.ubj

# Active policy corpus version recorded in every Decision Bundle. Update
# when ingesting a new corpus snapshot via the corpus loader.
ATO_CORPUS_VERSION=ato-v1
