# =============================================================================
# DecisionLedger — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- LLM policy gate ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- PostgreSQL (matches docker-compose.yml defaults) ---
POSTGRES_USER=account_takeover
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=account_takeover
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=account_takeover:events
REDIS_CONSUMER_GROUP=account_takeover:consumers
REDIS_DEDUP_TTL_S=3600

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_POLICY_INDEX=account_takeover-policy

# --- Scorer routing thresholds ---
# Events below LOW → ALLOW fast path. Events above HIGH → BLOCK fast path.
# Events between thresholds → route to LLM policy gate.
SCORER_LOW_CONFIDENCE_THRESHOLD=0.2
SCORER_HIGH_CONFIDENCE_THRESHOLD=0.8
SCORER_TOP_K_SIGNALS=5

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
RERANK_TIMEOUT_MS=500      # Cross-encoder latency budget; bypass to RRF-only if exceeded

# --- Ingestion ---
BOUNDED_LATENESS_S=300     # Events older than this (seconds) routed to dead-letter queue

# --- Enforcement ---
NOVEL_ENTITY_MIN_EVENTS=10 # Accounts with fewer events → HOLD routing trigger

# --- LLM configuration ---
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
