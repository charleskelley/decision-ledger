###############################################################################
# DecisionLedger — Reasoner ↔ Framework Handoff
#
# The single integration boundary. Domain-side: raw event + features +
# scorer output → build_observation(). Handoff payload: Observation
# (ReasonerContext + GateContext + optional fast_path_rationale).
# Framework-side: route → (retrieval + gate) | fast path → enforcement →
# bundle.
#
# Render:  d2 --theme 0 --layout elk reasoner-handoff.d2 ../../assets/diagrams/reasoner-handoff.svg
# Ref:     docs/design/reasoner-handoff.md
###############################################################################

title: Reasoner ↔ Framework Handoff {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

direction: down

###############################################################################
# Palette (matches the rest of the diagram set)
#   Domain          fill #e8eef9 / stroke #5b6abf  (indigo)
#   Framework       fill #e8f5f3 / stroke #0d9488  (teal)
#   Handoff payload fill #f9f9f9 / stroke #1c2024  (neutral)
#   Fast-path       fill #fef3e8 / stroke #c9622e  (burnt orange)
#   Diamond         filled coloured / white text
###############################################################################

###############################################################################
# Domain Layer (left)
###############################################################################

domain: Domain Layer  ·  reasoner/account_takeover {
  style.fill: "#eff3fb"
  style.stroke: "#5b6abf"
  style.stroke-width: 2

  evt: LoginEvent {
    style.fill: "#e8eef9"
    style.stroke: "#5b6abf"
    tooltip: "Raw authentication event. Schema lives entirely in the domain."
  }
  feats: AtoFeatureVector {
    style.fill: "#e8eef9"
    style.stroke: "#5b6abf"
    tooltip: "Sliding-window behavioural features (velocity, novelty, geo, device consistency)."
  }
  score: ScorerOutput {
    style.fill: "#e8eef9"
    style.stroke: "#5b6abf"
    tooltip: "XGBoost risk_score + top SHAP signals + GateRoute decision."
  }
  asm: build_observation() {
    shape: diamond
    style.fill: "#5b6abf"
    style.stroke: "#5b6abf"
    style.font-color: "#ffffff"
    style.bold: true
    tooltip: "The only function crossing the domain → framework boundary. Translates the three domain artifacts into the framework Observation contract."
  }

  evt -> asm
  feats -> asm
  score -> asm
}

###############################################################################
# Handoff payload — Observation (centre)
###############################################################################

obs: Observation {
  style.fill: "#fafafa"
  style.stroke: "#1c2024"
  style.stroke-width: 2

  rc: ReasonerContext {
    style.fill: "#e8f5f3"
    style.stroke: "#0d9488"
    tooltip: "Domain-agnostic ML evidence: reasoner_id, model_version, inference_latency_ms, label_type/name/value, full feature_set (replay-self-contained), attribution."
  }
  gc: GateContext {
    style.fill: "#e8f5f3"
    style.stroke: "#0d9488"
    tooltip: "Gate dispatch envelope: gate_id, prompt_template_id, template_vars, jurisdictions, risk_tier. Required on EVERY observation, including fast-path (enables shadow evaluation)."
  }
  fpr: fast_path_rationale {
    style.fill: "#fef3e8"
    style.stroke: "#c9622e"
    tooltip: "Required iff route is FAST_PATH_ALLOW or FAST_PATH_BLOCK. Human-readable string explaining the confidence-band rule that fired (e.g., 'risk_score=0.93 > 0.85 → FAST_PATH_BLOCK')."
  }
  rt: route  ·  GateRoute {
    style.fill: "#e8f5f3"
    style.stroke: "#0d9488"
    tooltip: "FAST_PATH_ALLOW | FAST_PATH_BLOCK | ROUTE_TO_GATE. Determines the framework-side path."
  }
}

###############################################################################
# Framework Layer (right)
###############################################################################

framework: Framework Layer  ·  core/ + app/ {
  style.fill: "#f3faf8"
  style.stroke: "#0d9488"
  style.stroke-width: 2

  validate: validate_observation() {
    shape: diamond
    style.fill: "#0d9488"
    style.stroke: "#0d9488"
    style.font-color: "#ffffff"
    style.bold: true
    tooltip: "Framework intake gate. Enforces: reasoner_context populated; fast_path_rationale populated iff route is fast-path. Raises ObservationContractError naming the responsible reasoner."
  }
  router: route dispatch {
    shape: diamond
    style.fill: "#0d9488"
    style.stroke: "#0d9488"
    style.font-color: "#ffffff"
    tooltip: "ROUTE_TO_GATE → retrieval + gate.  FAST_PATH_* → fast_path."
  }
  retr_gate: Retrieval + Policy Gate {
    style.fill: "#e8f5f3"
    style.stroke: "#0d9488"
    tooltip: "Hybrid retrieval (pgvector + ES + rerank) → LLM policy gate (rendered template + structured-output JSON verdict)."
  }
  fp: Fast Path {
    style.fill: "#fef3e8"
    style.stroke: "#c9622e"
    tooltip: "Skip retrieval and live gate. Enforce ALLOW or BLOCK directly. GateContext is preserved on the bundle so the gate can be replayed offline (shadow evaluation)."
  }
  enf: Enforcement {
    style.fill: "#e8f5f3"
    style.stroke: "#0d9488"
    tooltip: "Pure deterministic resolver — re-runnable byte-identically against the cached gate verdict. The replay guarantee."
  }
  bundle: DecisionBundle {
    style.fill: "#fbf3e6"
    style.stroke: "#8c6d3f"
    tooltip: "Append-only audit record: raw_event (Observation), retrieval results, gate_input/gate_output, enforcement decision, latency breakdown."
  }

  validate -> router
  router -> retr_gate: "ROUTE_TO_GATE" {
    style.stroke: "#0d9488"
  }
  router -> fp: "FAST_PATH_*" {
    style.stroke: "#c9622e"
  }
  retr_gate -> enf
  fp -> enf
  enf -> bundle
}

###############################################################################
# Cross-boundary flows
###############################################################################

domain.asm -> obs: "assembled Observation" {
  style.stroke: "#1c2024"
  style.stroke-width: 2
}

obs -> framework.validate: "submitted to framework" {
  style.stroke: "#1c2024"
  style.stroke-width: 2
}

###############################################################################
# What each Observation field powers (dashed, semantic)
###############################################################################

obs.rc -> framework.bundle: "stored verbatim\n(replay self-contained)" {
  style.stroke: "#0d9488"
  style.stroke-dash: 4
}
obs.gc -> framework.retr_gate: "jurisdictions + risk_tier → retrieval filters\ntemplate_vars → prompt render" {
  style.stroke: "#0d9488"
  style.stroke-dash: 4
}
obs.gc -> framework.fp: "preserved for\nshadow evaluation" {
  style.stroke: "#c9622e"
  style.stroke-dash: 4
}
obs.fpr -> framework.bundle: "stored verbatim\n(fast-path only)" {
  style.stroke: "#c9622e"
  style.stroke-dash: 4
}
obs.rt -> framework.router: "drives dispatch" {
  style.stroke: "#0d9488"
  style.stroke-dash: 4
}
