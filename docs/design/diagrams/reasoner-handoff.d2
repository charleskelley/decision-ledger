###############################################################################
# DecisionLedger — Submission Flow
#
# The single integration boundary between a reasoner and the ledger.
# Reasoner side: event → features → score → build_submission(), which
# records under the strictest registered bypass rule that holds
# (core.submission.matching_bypass_rule) or asks the ledger to gate the
# decision. The handoff payload is the Submission (wire schema version 2,
# schemas/submission-v2.json), sent through LocalClient (in process) or
# HttpClient (over HTTP, POST /api/v1/decisions). Ledger side
# (app/submit.py): validate → identity → mandatory gates → advisory gates
# (gate mode only; skipped once a mandatory gate blocks) → enforcement and
# the combinator → the version-2 bundle is written → the receipt goes back to
# the reasoner. In record mode the advisory gates are recorded as skipped and
# the cited bypass rule is checked against the submission's evidence.
#
# The reasoner nodes name ATO's types as the example: they are the reference
# reasoner's (reasoners/account_takeover), not framework types. The framework
# never imports a reasoner; it sees only the Submission.
#
# Render:  d2 --theme 0 --layout elk reasoner-handoff.d2 ../../assets/diagrams/reasoner-handoff.svg
# Ref:     docs/design/reasoners/reasoner-handoff.md, app/submit.py,
#          core/submission.py, DR-29 to DR-32
###############################################################################

title: Submission Flow {
  near: top-center
  shape: text
  style.font-size: 34
  style.bold: true
}

direction: down

###############################################################################
# Palette (matches the rest of the diagram set)
#   Domain          fill #e8eef9 / stroke #5b6abf  (indigo)
#   Framework       fill #e8f5f3 / stroke #0d9488  (teal)
#   Handoff payload fill #fafafa / stroke #1c2024  (neutral)
#   Identity        fill #fef3e8 / stroke #c9622e  (burnt orange)
#   Datastore       fill #fbf3e6 / stroke #8c6d3f  (ochre)
#   Diamond         filled colored / white text
# Gate-mode edges are solid; record-mode edges are dashed.
###############################################################################

# Node text 22px and edge text 20px keep the labels legible at the docs
# column width
classes: {
  domain: {style: {fill: "#e8eef9"; stroke: "#5b6abf"; stroke-width: 2; font-size: 22}}
  framework: {style: {fill: "#e8f5f3"; stroke: "#0d9488"; stroke-width: 2; font-size: 22}}
  field: {style: {fill: "#ffffff"; stroke: "#1c2024"; stroke-width: 1; font-size: 20}}
  identity: {style: {fill: "#fef3e8"; stroke: "#c9622e"; stroke-width: 2; font-size: 22}}
  bundle: {style: {fill: "#fbf3e6"; stroke: "#8c6d3f"; stroke-width: 2; font-size: 22}}

  domain-flow: {style: {stroke: "#5b6abf"; stroke-width: 2; font-size: 20}}
  flow: {style: {stroke: "#0d9488"; stroke-width: 2; font-size: 20}}
  record-flow: {style: {stroke: "#0d9488"; stroke-width: 2; stroke-dash: 5; font-size: 20}}
  handoff: {style: {stroke: "#1c2024"; stroke-width: 2; font-size: 20}}
}

###############################################################################
# Reasoner (top)
###############################################################################

reasoner: "Reasoner  ·  e.g. ato_reasoner (reasoners/account_takeover)" {
  style: {fill: "#eff3fb"; stroke: "#5b6abf"; stroke-width: 2; font-size: 24}

  # One row of domain artifacts keeps the canvas short (elk ignores a
  # container's direction, so a grid lays the row out). The dashed frame
  # shows that the edge to build_submission() leaves the whole row.
  inputs: "" {
    grid-columns: 3
    grid-gap: 16
    horizontal-gap: 48
    style: {fill: transparent; stroke: "#5b6abf"; stroke-dash: 4; border-radius: 8}

    evt: "Event\n(ATO: LoginEvent)" {
      class: domain
      tooltip: "The domain's raw event. It crosses to the ledger only as opaque raw_event JSON."
    }
    feats: "Features\n(ATO: AtoFeatureVector)" {
      class: domain
      tooltip: "Every feature the model consumed; it travels as reasoner_context.feature_set, which bypass rules and replay read."
    }
    score: "Score\n(ATO: ScorerOutput)" {
      class: domain
      tooltip: "ATO's XGBoost risk score and top signals; it travels as reasoner_context.label_value and attribution."
    }

    evt -> feats: {class: domain-flow}
    feats -> score: {class: domain-flow}
  }

  asm: "build_submission()\nrecords under the strictest registered\nbypass rule that holds, or asks for a gate" {
    style: {fill: "#5b6abf"; stroke: "#5b6abf"; font-color: "#ffffff"; font-size: 22}
    tooltip: "The reasoner's assembler. core.submission.matching_bypass_rule returns the strictest registered bypass rule that holds: the submission records that rule's action and cites it (mode record); when none holds it asks for a gate (mode gate). ATO's rules are allow-band (label_value < 0.20, ALLOW) and block-band (label_value > 0.95, BLOCK)."
  }

  inputs -> asm: {class: domain-flow}
}

###############################################################################
# Handoff payload — the Submission (middle)
###############################################################################

sub: "Submission  ·  wire schema v2" {
  style: {fill: "#fafafa"; stroke: "#1c2024"; stroke-width: 2; font-size: 24}
  grid-columns: 3
  grid-gap: 16

  # The fields carry no tooltips: their info icons would sit on the
  # container's label.
  #   mode         record (the reasoner decided and cites a bypass rule) or
  #                gate (the ledger gates it; proposed_action optional)
  #   bypass       BypassCitation: a registered rule id pinned to its
  #                version; required if and only if mode is record
  #   subject      the native subject the reasoner scored, in a namespace
  #                its registration declares (ATO: ato-account); the ledger
  #                resolves it to the decision's subject
  #   gate_contexts required on every submission, recorded ones too, so a
  #                recorded decision can be shadow-evaluated later
  mode: "mode: record | gate\nproposed_action" {class: field}
  bypass: "bypass\n(record only: the cited rule)" {class: field}
  subject: "native_subject\nentity_id · entity_type" {class: field}
  rc: "reasoner_context\n(evidence, full feature_set)" {class: field}
  gcs: "gate_contexts\n(one per bound gate)" {class: field}
  raw: "raw_event\n(opaque JSON)" {class: field}
}

###############################################################################
# Clients
###############################################################################

local: "LocalClient\nin process:\ncreate_decision" {
  class: framework
  tooltip: "app/client.py — runs the ledger in the reasoner's process and calls create_decision, the operation the HTTP route runs."
}
http: "HttpClient\nover HTTP: POST\n/api/v1/decisions" {
  class: framework
  tooltip: "app/client.py — POST /api/v1/decisions with the reasoner's key in X-DecisionLedger-Key."
}

###############################################################################
# Ledger (bottom)
###############################################################################

ledger: "Ledger\napp/submit.py" {
  style: {fill: "#f3faf8"; stroke: "#0d9488"; stroke-width: 2; font-size: 24}
  # Top-left, on two lines, keeps the label clear of the client edges
  # entering at the top and the receipt edge leaving at the bottom
  label.near: top-left

  validate: "1 Validate\nregistration · citation · gate configs" {
    class: framework
    tooltip: "Any failure raises SubmissionContractError (a 422 problem) before a gate runs; nothing is persisted."
  }
  identity: "2 Identity\nresolver or passthrough" {
    class: identity
    tooltip: "IdentityService.identify, under a 50 ms default budget. Any failure records the passthrough subject, unresolved, with the reason; a decision is never refused over its identity."
  }
  mandatory: "3 Mandatory gates\n(every decision, concurrently)" {
    class: framework
  }
  mode: "mode?" {
    shape: diamond
    style: {fill: "#0d9488"; stroke: "#0d9488"; font-color: "#ffffff"; bold: true; font-size: 22}
  }
  advisory: "4 Advisory gates\n(concurrently; skipped once\na mandatory gate blocks)" {
    class: framework
  }
  enforce: "5 Enforcement + combinator\nmost restrictive action wins" {
    class: framework
    tooltip: "Gate-level tiers per gate output, then the decision-level rules and the combinator over ALLOW < CHALLENGE < HOLD < BLOCK. A failing gate fails closed (HOLD). The bypass checks are snapshotted into the bundle."
  }
  write: "6 Version-2 bundle written\nstamped with registration_version" {
    class: bundle
  }

  validate -> identity: {class: flow}
  identity -> mandatory: {class: flow}
  mandatory -> mode: {class: flow}
  mode -> advisory: "gate" {class: flow}
  advisory -> enforce: {class: flow}
  mode -> enforce: "record: advisory gates\nrecorded skipped; cited\nbypass rule checked" {class: record-flow}
  enforce -> write: {class: flow}
}

# What the reasoner gets back
receipt: "DecisionReceipt, back to the reasoner\ndecision_id · decision_action · mode · gates" {
  class: domain
  tooltip: "app/api/models.py — the decision's outcome (the resolved entity_id and entity_type, the bypass rule and whether it held, the registration_version, every gate's status, the latency breakdown), not its full record; the bundle is at GET /api/v1/decisions/{decision_id}."
}

###############################################################################
# Cross-boundary flows
###############################################################################

reasoner.asm -> sub: {class: handoff}
sub -> local: {class: handoff}
sub -> http: {class: handoff}
local -> ledger.validate: {class: flow}
http -> ledger.validate: {class: flow}
ledger.write -> receipt: {class: flow}
