###############################################################################
# DecisionLedger — Evaluation Harnesses
#
# Two harnesses, one report format. The framework harness
# (eval/runners/harness.py) owns the reasoner-facing dimensions: decision
# consistency and adversarial robustness, driven through each reasoner's own
# pipeline, and shadow evaluation, which samples the decisions the run
# recorded and re-decides them with the reasoner's advisory gates
# (report-only). The RAG policy gate's harness (policy_rag_gate.eval) owns
# the dimensions that measure that gate: retrieval quality, generation
# faithfulness, and citation accuracy, with LLM judges, run on the datasets
# each reasoner ships for the gate (DR-28).
#
# Everything reasoner-specific comes from the EvalAdapter the reasoner
# publishes under the decisionledger.eval_adapters entry point, selected
# with --reasoner-id: its datasets_dir and its build_driver() (ATO:
# ato_reasoner.eval.adapter:ADAPTER, datasets under
# reasoners/account_takeover/src/ato_reasoner/eval/datasets/). The driver
# runs the reasoner's pipeline, which submits through a LocalClient over the
# same framework services the ledger builds, so eval cannot drift from
# runtime wiring.
#
# Each harness writes an EvalReport (core.eval.metrics) through run_eval:
#   framework  outputs/stage/eval/reasoner/<reasoner_id>/eval-report.json
#   RAG gate   outputs/stage/eval/gate/policy/<reasoner_id>/eval-report.json
# Both exit 0 (passed), 1 (a threshold failed), or 2 (configuration error).
#
# Render:  d2 --theme 0 --layout elk eval-harness.d2 ../../assets/diagrams/eval-harness.svg
# Ref:     docs/design/evaluation.md, eval/README.md, eval/runners/harness.py,
#          eval/adapter.py, gates/policy_rag/src/policy_rag_gate/eval/harness.py
###############################################################################

title: Evaluation Harnesses {
  near: top-center
  shape: text
  style.font-size: 34
  style.bold: true
}

direction: down

###############################################################################
# Palette
#   Eval / harness   fill #fef3e8 / stroke #c9622e  (burnt orange)
#   Dimension        fill #fbe6d6 / stroke #c9622e  (deeper orange)
#   Reasoner-owned   fill #e8eef9 / stroke #5b6abf  (indigo)
#   Framework        fill #e8f5f3 / stroke #0d9488  (teal)
#   Gate code        fill #ffffff / stroke #0d9488, dashed  (the RAG gate's
#                    own retriever, not framework code)
#   Judge LLM        fill #f5e8f5 / stroke #b45dc9  (violet)
#   Datastore        fill #fbf3e6 / stroke #8c6d3f  (ochre)
#   Report           fill #fbfbfb / stroke #1c2024  (neutral)
###############################################################################

# Node text 22px and edge text 20px keep the labels legible at the docs
# column width
classes: {
  harness: {style: {fill: "#fef3e8"; stroke: "#c9622e"; stroke-width: 3; font-size: 24}}
  dim: {style: {fill: "#fbe6d6"; stroke: "#c9622e"; stroke-width: 2; font-size: 22}}
  reasoner: {style: {fill: "#e8eef9"; stroke: "#5b6abf"; stroke-width: 2; font-size: 22}}
  framework: {style: {fill: "#e8f5f3"; stroke: "#0d9488"; stroke-width: 2; font-size: 22}}
  llm: {shape: cloud; style: {fill: "#f5e8f5"; stroke: "#b45dc9"; stroke-width: 2; font-size: 22}}
  datastore: {shape: cylinder; style: {fill: "#fbf3e6"; stroke: "#8c6d3f"; stroke-width: 2; font-size: 22}}
  report: {shape: page; style: {fill: "#fbfbfb"; stroke: "#1c2024"; stroke-width: 2; font-size: 20}}

  from-reasoner: {style: {stroke: "#5b6abf"; stroke-dash: 4; font-size: 20}}
  calls: {style: {stroke: "#0d9488"; font-size: 20}}
  judges: {style: {stroke: "#b45dc9"; stroke-dash: 4; font-size: 20}}
  reads: {style: {stroke: "#8c6d3f"; stroke-dash: 4; font-size: 20}}
  writes: {style: {stroke: "#c9622e"; stroke-width: 2; font-size: 20}}
}

###############################################################################
# The reasoner's adapter: datasets and driver
###############################################################################

adapter: "EvalAdapter (one per reasoner)\ndecisionledger.eval_adapters" {
  class: reasoner
  tooltip: "Loaded by eval/adapter.py:load_eval_adapter(--reasoner-id). ATO: ato_reasoner.eval.adapter:ADAPTER."
}

###############################################################################
# The framework harness
###############################################################################

fw: "Framework harness\neval/runners/harness.py" {
  class: harness
  # The dimensions carry no tooltips: their info icons would sit on the
  # harness label. Consistency: the same signals in several orderings must
  # give the same final action. Robustness: injection, schema violation,
  # novel patterns, fallback. Shadow: re-decides a sample of the run's
  # recorded decisions with the advisory gates (app.submit.run_gate_set)
  # and compares; it writes nothing.

  cons: "Consistency\nscenarios/" {class: dim}

  rob: "Robustness\nrobustness/" {class: dim}

  shadw: "Shadow\n(report-only)" {class: dim}

}

driver: "EvalDriver\nthe reasoner's\nown pipeline,\nvia LocalClient" {
  class: reasoner
  tooltip: "Built by the adapter (ATO: ato_reasoner.eval.driver). Uses app.bootstrap.build_framework_services, the wiring the ledger itself uses."
}

ledger: "Ledger services\ngates, enforcement,\nbundle store" {
  class: framework
}

bundles: "PostgreSQL\ndecision_bundles" {
  class: datastore
}

fw_report: "EvalReport\noutputs/stage/eval/reasoner/\n<reasoner_id>/eval-report.json" {
  class: report
}

###############################################################################
# The RAG policy gate's harness
###############################################################################

gate: "RAG policy gate harness\npolicy_rag_gate.eval" {
  class: harness
  # Retrieval: retrieval/golden_queries.yaml against the gate's own hybrid
  # retriever, tenant-filtered. Faithfulness: faithfulness/golden_outputs.yaml,
  # RAGAS claim grounding plus an LLM judge. Citation:
  # citations/golden_outputs.yaml, an LLM judge rates each citation.

  retr: "Retrieval\nretrieval/" {class: dim}

  faith: "Faithfulness\nfaithfulness/" {class: dim}

  cite: "Citation\ncitations/" {class: dim}

}

retriever: "Gate's hybrid\nretriever\nElasticsearch\n+ pgvector" {
  class: framework
  style.fill: "#ffffff"
  style.stroke-dash: 4
  tooltip: "policy_rag_gate.retriever, opened by policy_rag_gate.plugin.open_retriever: the gate's own stores, with the reasoner's corpus indexed."
}

judges: "LLM judges\nRAGAS (OpenAI)\njudge (Anthropic)" {
  class: llm
}

gate_report: "EvalReport\noutputs/stage/eval/gate/policy/\n<reasoner_id>/eval-report.json" {
  class: report
}

###############################################################################
# Edges
###############################################################################

adapter -> gate: "datasets_dir" {class: from-reasoner}
adapter -> fw: "datasets_dir\nbuild_driver()" {class: from-reasoner}

fw.cons -> driver: "orderings" {class: calls}
fw.rob -> driver: "adversarial\nevents" {class: calls}
driver -> ledger: "submissions" {class: calls}
ledger -> bundles: "writes" {class: reads}
fw.shadw -> bundles: "samples the\nrun's records" {class: reads}
fw.shadw -> ledger: "advisory gates,\noffline" {class: calls}
fw -> fw_report: "run_eval()" {class: writes}

gate.retr -> retriever: "golden queries" {class: calls}
gate.faith -> judges: "grounding" {class: judges}
gate.cite -> judges: "citation\nsupport" {class: judges}
gate -> gate_report: "run_eval()" {class: writes}
