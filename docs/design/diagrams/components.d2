###############################################################################
# DecisionLedger — C4 Level 3: Ledger API Components
#
# Zooms into the Ledger API container (app/main.py:create_app). A request
# enters through the routes and the key ring (app/api/, app/auth.py), which
# map the X-DecisionLedger-Key header to a principal, and reaches one of the
# ledger's operations; LocalClient (app/client.py) enters at the same
# operations in process, as the trusted caller. A decision write runs
# decide()/submit() (app/submit.py), the framework half of every decision:
# intake validation → the identity step → the gate set → gate invocation
# (mandatory gates concurrently, then advisory ones) → gate-level enforcement
# → the decision-level rules and the combinator → the bundle store write.
# Side paths: replay re-enforces a bundle's stored gate outputs under its
# registration snapshot and logs the outcome to replay_logs; the registry
# snapshots every registration version; the entity journal and the timeline
# query serve a subject's decisions.
# Teal components are framework code; dashed ones are plugins the framework
# loads but does not implement (gate plugins, the identity resolver).
#
# Render:  d2 --theme 0 components.d2 ../../assets/diagrams/components.svg
#          (uses dagre — see justfile for the special-case)
# Ref:     docs/design/architecture.md, docs/design/pipeline.md,
#          docs/design/identity.md
###############################################################################

title: Components — Ledger API {
  near: top-center
  shape: text
  style.font-size: 34
  style.bold: true
}

direction: down

###############################################################################
# Palette
#   Framework        fill #e8f5f3 / stroke #0d9488  (teal)
#   Decision steps   fill #ffffff / stroke #0d9488  (teal outline, in the
#                    decide/submit container)
#   Gate plugin      fill #ffffff / stroke #0d9488, dashed
#   Identity         fill #fef3e8 / stroke #c9622e, dashed  (burnt orange:
#                    the enterprise's resolver plugin or the passthrough)
#   Datastore        fill #fbf3e6 / stroke #8c6d3f  (ochre)
#   Caller           fill #f0f0f0 / stroke #1c2024  (neutral)
###############################################################################

# Node text 22px and edge text 20px keep the labels legible at the docs
# column width
classes: {
  caller: {style: {fill: "#f0f0f0"; stroke: "#1c2024"; stroke-width: 2; font-size: 22}}
  framework: {style: {fill: "#e8f5f3"; stroke: "#0d9488"; stroke-width: 2; font-size: 22}}
  step: {style: {fill: "#ffffff"; stroke: "#0d9488"; stroke-width: 2; font-size: 22}}
  plugin: {style: {fill: "#ffffff"; stroke: "#0d9488"; stroke-width: 2; stroke-dash: 4; font-size: 22}}
  identity: {style: {fill: "#fef3e8"; stroke: "#c9622e"; stroke-width: 2; stroke-dash: 4; font-size: 22}}
  datastore: {shape: cylinder; style: {fill: "#fbf3e6"; stroke: "#8c6d3f"; stroke-width: 2; font-size: 22}}

  flow: {style: {stroke: "#0d9488"; stroke-width: 2; font-size: 20}}
  side: {style: {stroke: "#0d9488"; stroke-dash: 4; font-size: 20}}
  to-plugin: {style: {stroke: "#0d9488"; stroke-dash: 4; font-size: 20}}
  to-identity: {style: {stroke: "#c9622e"; stroke-dash: 4; font-size: 20}}
  to-store: {style: {stroke: "#8c6d3f"; font-size: 20}}
  from-caller: {style: {stroke: "#1c2024"; font-size: 20}}
}

###############################################################################
# Entry: callers, routes, operations
###############################################################################

http: "HTTP callers\n(reasoner services, MCP server, analyst)" {
  class: caller
}

local: "LocalClient\n(in-process caller)" {
  class: framework
  tooltip: "app/client.py — runs the ledger in the caller's process and calls the same operations the HTTP routes call, as the trusted in-process principal. Eval drivers, tests, and a reasoner that embeds the ledger use it."
}

routes: "Routes + KeyRing\napp/api/ · app/auth.py" {
  class: framework
  tooltip: "GET /health and the /api/v1 routes. KeyRing maps X-DecisionLedger-Key to a principal: a reasoner (bound to its reasoner_id) or the operator. Errors are RFC 9457 problem documents with a stable code (app/api/errors.py)."
}

ops: "Operations\ncreate_decision · record_batch\nlookup_decision · replay_decision\nresolve_decision · entity_decisions" {
  class: framework
  tooltip: "app/api/decisions.py and app/api/entities.py: the functions the routes and LocalClient both call."
}

###############################################################################
# decide() / submit() — the framework half of every decision
###############################################################################

submit: "decide() / submit()\napp/submit.py" {
  style: {fill: "#f3faf8"; stroke: "#0d9488"; stroke-width: 2; font-size: 26}
  # Bottom-right, on two lines, keeps the label clear of the edges entering
  # at the top and the bundle edge leaving at the bottom
  label.near: bottom-right

  validate: "Intake validation\nregistration · submission · gate configs" {
    class: step
    tooltip: "The reasoner must be registered; validate_submission checks the record's bypass citation, the native subject, and the gate contexts; each composed gate checks its own config_model (and ConfigAuthorizer). A failure raises SubmissionContractError before any gate runs."
  }
  identity: "Identity step\nIdentityService.identify" {
    class: step
    tooltip: "Resolves the submission's native subject through the active resolver in a worker thread under a 50 ms budget (DEFAULT_IDENTITY_BUDGET_MS). Any failure gives the passthrough subject, unresolved, with the reason. It never refuses a decision."
  }
  gateset: "Gate set\nregistration bindings + deployment mandates" {
    class: step
  }
  invoke: "Gate invocation · invoke_gate\nmandatory gates concurrently, then advisory\n(gate mode only); a failing gate fails closed" {
    class: step
    tooltip: "Advisory gates run only on a gated decision, and are skipped (recorded with the reason) once a mandatory gate blocks. A gate that raises, outlives its budget (45 s default), returns an unusable output, or is not composed is recorded failed and holds the decision."
  }
  gatelevel: "Gate-level enforcement\nresolve_gate_output" {
    class: step
  }
  decisionlevel: "Decision-level rules + combinator\nresolver.resolve_decision" {
    class: step
    tooltip: "app/enforcement/resolver.py — the decision-level rules, the bypass checks (snapshotted into the bundle), and the most-restrictive combinator over ALLOW < CHALLENGE < HOLD < BLOCK."
  }

  validate -> identity: {class: flow}
  identity -> gateset: {class: flow}
  gateset -> invoke: {class: flow}
  invoke -> gatelevel: "GateOutput per gate" {class: flow}
  gatelevel -> decisionlevel: {class: flow}
}

store: "Bundle store write\nBundleStore.write" {
  class: framework
  tooltip: "app/audit/store.py — writes the version-2 bundle stamped with registration_version, and opens the relationships its identity asserts in the membership projection."
}

###############################################################################
# Plugins the framework loads but does not implement
###############################################################################

resolver: "Identity resolver plugin\nor the passthrough" {
  class: identity
  tooltip: "decisionledger.identity_resolvers entry point named by DECISIONLEDGER_IDENTITY_RESOLVER (app/identity/resolvers.py); the passthrough (app/identity/passthrough.py) when none is configured."
}

gates: "Gate plugins\ndecisionledger.gates" {
  class: plugin
  tooltip: "Composed by app/gates.py. Each gate's evaluate(GateRequest) returns a GateOutput; the ledger enforces it."
}

###############################################################################
# Side paths
###############################################################################

registry: "Registry + registration snapshots\napp/plugins.py · app/audit/registrations.py" {
  class: framework
  tooltip: "The plugins' registrations plus the registration file's (DECISIONLEDGER_REGISTRATIONS). Each version is snapshotted to reasoner_registrations before the first decision; intake validates against the current version, replay against the bundle's registration_version."
}

replay: "Replay · BundleStore.replay\nre-enforces stored gate outputs\nunder the registration snapshot" {
  class: framework
  tooltip: "app/audit/store.py — replay_bundle re-runs gate-level enforcement on each stored GateOutput, re-evaluates the bypass rules, and re-applies the decision-level rules and the combinator; no gate is invoked. BundleStore.replay appends the outcome to replay_logs."
}

timeline: "Entity journal + timelines\nEntityJournal · entity_decisions" {
  class: framework
  tooltip: "app/audit/entity_journal.py (entity_events, append-only; entity_membership, its projection) and BundleStore.entity_decisions (a subject's decisions, unioning merged ids and, on request, related subjects)."
}

pg: "PostgreSQL · schema decisionledger" {
  class: datastore
  tooltip: "decision_bundles, replay_logs, decision_resolution_attempts, reasoner_registrations, entity_events, entity_membership (app/audit/sql/02_tables.sql)."
}

###############################################################################
# Flow
###############################################################################

http -> routes: "X-DecisionLedger-Key" {class: from-caller}
routes -> ops: "principal" {class: flow}
local -> ops: "trusted principal" {class: flow}

ops -> submit.validate: {class: flow}
submit.decisionlevel -> store: "version-2 bundle" {class: flow}
store -> pg: "INSERT bundle\n(append-only)" {class: to-store}

submit.identity -> resolver: "native subject" {class: to-identity}
submit.invoke -> gates: "GateRequest" {class: to-plugin}

registry -> submit.validate: "registration" {class: side}
registry -> pg: {class: to-store}

ops -> replay: "replay_decision" {class: side}
registry -> replay: {class: side}
replay -> pg: "stored bundle,\nreplay log" {class: to-store}

ops -> timeline: "entity_decisions" {class: side}
timeline -> pg: "journal, projection,\nbundles" {class: to-store}
