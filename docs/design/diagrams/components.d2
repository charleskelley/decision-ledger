###############################################################################
# DecisionLedger — C4 Level 3: Decision Pipeline Components
#
# Zooms into the Decision API container (app/main.py + app/decide.py).
# Shows execute_pipeline(): domain assembly → routing → retrieval + gate
# (or fast path) → enforcement → audit. The Reasoner Assembler is the
# single handoff point between the domain and framework layers (the
# left/right halves of the diagram, distinguished by indigo vs teal).
#
# Render:  d2 --theme 0 components.d2 ../../assets/diagrams/components.svg
#          (uses dagre — see justfile for the special-case)
# Ref:     docs/design/architecture.md, docs/design/pipeline.md, docs/design/reasoner-handoff.md
###############################################################################

title: |md
  # Components — Decision Pipeline (`app/decide.py`)
| {near: top-center}

direction: down

###############################################################################
# Palette
#   Domain layer       fill #e8eef9 / stroke #5b6abf  (indigo)
#   Framework layer    fill #e8f5f3 / stroke #0d9488  (teal)
#   Routing diamond    filled teal / white text
#   Fast-path branch   fill #fef3e8 / stroke #c9622e  (burnt orange)
#   Datastore          fill #fbf3e6 / stroke #8c6d3f  (ochre)
#   Streaming state    fill #e8f5f5 / stroke #2e8b8b  (cyan)
#   LLM provider       fill #f5e8f5 / stroke #b45dc9  (violet)
###############################################################################

###############################################################################
# Inputs
###############################################################################

input: LoginEvent {
  shape: rectangle
  style.fill: "#f0f0f0"
  style.stroke: "#1c2024"
  tooltip: "Validated LoginEvent — entered via POST /api/v1/decisions or the in-process eval PipelineDriver."
}

###############################################################################
# Domain layer (indigo) — pre-handoff
###############################################################################

features: Feature Engine {
  style.fill: "#e8eef9"
  style.stroke: "#5b6abf"
  style.stroke-width: 2
  tooltip: "FeatureService.compute() — sliding-window velocity + novelty + impossible-travel features over Redis state. app/features/."
}

redis_state: Redis  ·  feature state {
  shape: cylinder
  style.fill: "#e8f5f5"
  style.stroke: "#2e8b8b"
  style.stroke-width: 2
  tooltip: "Per-account hashes + sorted sets for sliding windows. TTL-managed."
}

scorer: ATO Scorer {
  style.fill: "#e8eef9"
  style.stroke: "#5b6abf"
  style.stroke-width: 2
  tooltip: "AtoScorer.score() — XGBoost over AtoFeatureVector → ScorerOutput (risk_score, top SHAP signals, GateRoute). app/scorer/."
}

assembler: Reasoner Assembler {
  style.fill: "#5b6abf"
  style.stroke: "#5b6abf"
  style.font-color: "#ffffff"
  style.bold: true
  style.stroke-width: 2
  tooltip: "build_observation() — the only function crossing the domain → framework boundary. Translates (LoginEvent, AtoFeatureVector, ScorerOutput) into an Observation with ReasonerContext + GateContext + (fast_path_rationale on fast path)."
}

###############################################################################
# Routing diamond
###############################################################################

route: Route? {
  shape: diamond
  style.fill: "#0d9488"
  style.stroke: "#0d9488"
  style.font-color: "#ffffff"
  style.bold: true
  style.stroke-width: 2
  tooltip: "Inspects observation.route. FAST_PATH_ALLOW < 0.20; FAST_PATH_BLOCK > 0.85; otherwise ROUTE_TO_GATE."
}

###############################################################################
# Framework layer (teal) — post-handoff
###############################################################################

retrieval: Hybrid Retrieval {
  style.fill: "#e8f5f3"
  style.stroke: "#0d9488"
  style.stroke-width: 2
  tooltip: "PolicyRetriever.retrieve() — pgvector HNSW (dense) + Elasticsearch BM25 (sparse) → RRF fusion → cross-encoder rerank (latency-budget bypass falls back to RRF-only). Filters: jurisdictions on both stores; risk_tier on pgvector only. app/retrieval/."
}

gate: Policy Gate {
  style.fill: "#e8f5f3"
  style.stroke: "#0d9488"
  style.stroke-width: 2
  tooltip: "PolicyGate.evaluate() — resolves the YAML prompt template via prompt_template_id, renders with template_vars + retrieved snippets, calls the LLM with a structured-output schema, returns PolicyGateOutput (verdict + rationale + citations) or None on validation failure. app/gate/policy/."
}

fast_path: Fast Path {
  style.fill: "#fef3e8"
  style.stroke: "#c9622e"
  style.stroke-width: 2
  tooltip: "Bypasses retrieval + LLM. fast_path_rationale records why. GateContext is still preserved on the bundle for retrospective shadow evaluation."
}

enforcement: Enforcement Resolver {
  style.fill: "#e8f5f3"
  style.stroke: "#0d9488"
  style.stroke-width: 2
  tooltip: "resolve(obs, verdict, snippets, decision_id) — pure deterministic rule application. Schema-failure / novel-entity / adversarial-flag / jurisdiction-conflict → HOLD. Severity ladder ALLOW < CHALLENGE < HOLD < BLOCK. Re-runnable byte-identically for replay. app/enforcement/."
}

audit: Audit Builder + Store {
  style.fill: "#e8f5f3"
  style.stroke: "#0d9488"
  style.stroke-width: 2
  tooltip: "build_bundle() composes the immutable DecisionBundle (raw_event Observation, retrieval results, gate_input/gate_output, enforcement decision, latency breakdown). BundleStore.write() persists JSONB to Postgres. app/audit/."
}

###############################################################################
# External datastores + LLM
###############################################################################

pg_vec: PostgreSQL  ·  pgvector HNSW {
  shape: cylinder
  style.fill: "#fbf3e6"
  style.stroke: "#8c6d3f"
  style.stroke-width: 2
  tooltip: "Dense policy embeddings (384-dim, cosine, HNSW)."
}

es: Elasticsearch  ·  BM25 {
  shape: cylinder
  style.fill: "#fbf3e6"
  style.stroke: "#8c6d3f"
  style.stroke-width: 2
  tooltip: "Sparse policy index with jurisdiction + version filters."
}

llm: LLM Provider {
  shape: cloud
  style.fill: "#f5e8f5"
  style.stroke: "#b45dc9"
  style.stroke-width: 2
  tooltip: "OpenAI / Anthropic — structured-output policy-gate calls."
}

pg_audit: PostgreSQL  ·  decision_bundles {
  shape: cylinder
  style.fill: "#fbf3e6"
  style.stroke: "#8c6d3f"
  style.stroke-width: 2
  tooltip: "Append-only audit store: decision_bundles JSONB + replay_logs."
}

###############################################################################
# Flow — domain side (indigo)
###############################################################################

input -> features: "validated event" {
  style.stroke: "#1c2024"
}
features -> redis_state: "R/W window state" {
  style.stroke: "#2e8b8b"
}
features -> scorer: "AtoFeatureVector" {
  style.stroke: "#5b6abf"
}
scorer -> assembler: "ScorerOutput" {
  style.stroke: "#5b6abf"
}
assembler -> route: "Observation" {
  style.stroke: "#5b6abf"
  style.stroke-width: 2
}

###############################################################################
# Flow — framework side (teal / orange)
###############################################################################

route -> retrieval: "ROUTE_TO_GATE" {
  style.stroke: "#0d9488"
  style.stroke-width: 2
}
route -> fast_path: "FAST_PATH_ALLOW\n/ FAST_PATH_BLOCK" {
  style.stroke: "#c9622e"
  style.stroke-width: 2
}

retrieval -> gate: "RetrievedSnippet[]" {
  style.stroke: "#0d9488"
}
gate -> enforcement: "PolicyGateOutput.verdict\n(or None → HOLD)" {
  style.stroke: "#0d9488"
}
fast_path -> enforcement: "fast-path action" {
  style.stroke: "#c9622e"
}
enforcement -> audit: "EnforcementDecision" {
  style.stroke: "#0d9488"
}

retrieval -> pg_vec: "HNSW cosine\n+ jurisdiction / risk_tier" {
  style.stroke: "#8c6d3f"
}
retrieval -> es: "BM25\n+ jurisdiction" {
  style.stroke: "#8c6d3f"
}
gate -> llm: "rendered prompt\n→ JSON verdict" {
  style.stroke: "#b45dc9"
  style.stroke-dash: 4
}
audit -> pg_audit: "INSERT bundle JSONB\n(append-only)" {
  style.stroke: "#8c6d3f"
}
