###############################################################################
# DecisionLedger — C4 Level 2: Containers
#
# The containers that must be running for the system to work. Inside the
# DecisionLedger boundary: the Ledger API (the framework's FastAPI app,
# which loads the gate plugins and the identity resolver plugin in process)
# and PostgreSQL (schema decisionledger). The RAG policy gate's stores sit in
# their own gate-owned boundary inside it: Elasticsearch (its own
# compose.yaml) and the gate's policy_rag schema on the same Postgres server.
# Outside the boundary: the Account Takeover service with its own Redis; the
# MCP server agent reasoners call the ledger through; the LLM service the
# RAG gate calls; the enterprise's identity resolver; the analyst. Offline
# tools (corpus loader, eval harnesses, scorer trainer, scenario generator,
# baseline capture) run on demand and are left out, per the C4 container
# definition; see the caption in docs/design/architecture.md.
#
# - Account Takeover is the shipped reference reasoner and its own service.
#   With no ATO_LEDGER_URL it runs the ledger in its own process
#   (LocalClient, writing to the same Postgres); with ATO_LEDGER_URL set it
#   calls the Ledger API over HTTP. The edge names both.
# - The agent reasoner is illustrative (grey): any MCP client.
# - Edges from the Ledger API to the gate stores and the LLM are made by the
#   RAG gate's code running in the API process; the labels say so.
#
# Layout: the caller band is pinned above everything with
# `near: top-center`, as in system-context.d2. The rest is a three-column
# grid: analyst, the DecisionLedger boundary, and a right column with the
# LLM over the identity resolver. Grid cells stretch their shapes, so the
# side columns sit in padding-free wrapper grids whose invisible spacers set
# their offsets. Inside the boundary, a 2x2 grid puts the Ledger API over
# PostgreSQL in the left column, leaves the upper-right cell empty for the
# LLM and resolver edges, and puts the gate-owned stores lower right.
#
# Edge labels: d2 masks an edge only behind its label's text box. Multi-line
# labels keep the lines an edge crosses shorter than their widest line, and
# trailing " " lines extend the mask, so no dash touches the text.
#
# Sources (code paths for maintainers; nothing here renders):
#   Ledger API     app/main.py (create_app, lifespan, routes), app/api/,
#                  app/auth.py, app/bootstrap.py, app/gates.py,
#                  app/identity/, app/submit.py
#   PostgreSQL     docker-compose.yml, app/audit/sql/02_tables.sql,
#                  app/audit/store.py, app/audit/entity_journal.py
#   RAG gate       gates/policy_rag/compose.yaml (Elasticsearch),
#                  policy_rag_gate/sql/ (policy_rag schema),
#                  policy_rag_gate/es/policy-chunks.json,
#                  policy_rag_gate/retriever.py, policy_rag_gate/llm/openai.py
#   ATO service    ato_reasoner/app.py, reasoners/account_takeover/reasoner.mk
#                  (serve-account_takeover, port 8001), app/client.py,
#                  reasoners/account_takeover/compose.yaml (Redis)
#   MCP server     integrations/mcp/src/decisionledger_mcp/
#   Resolver       app/identity/resolvers.py (decisionledger.identity_resolvers),
#                  app/identity/passthrough.py
#   (ato_reasoner/ = reasoners/account_takeover/src/ato_reasoner/;
#    policy_rag_gate/ = gates/policy_rag/src/policy_rag_gate/)
#
# Render:  d2 --theme 0 --layout elk containers.d2 ../../assets/diagrams/containers.svg
# Ref:     docs/design/architecture.md, docs/design/infrastructure.md
###############################################################################

vars: {
  # Small pad (siblings use the default 100) maximizes scale at column width
  d2-config: {pad: 16}
}

# Analyst | DecisionLedger | LLM over resolver
grid-columns: 3
horizontal-gap: 24

###############################################################################
# Palette (kept consistent across the diagram set)
#   Domain        indigo  fill #e8eef9 / stroke #5b6abf / text #3f4b96
#   Framework     teal    fill #e8f5f3 / stroke #0d9488 / text #0b6e65
#   Datastore     ochre   fill #fbf3e6 / stroke #8c6d3f / text #6e552f
#   State store   cyan    fill #e8f5f5 / stroke #2e8b8b / text #1f6b6b
#   LLM or ML     violet  fill #f5e8f5 / stroke #b45dc9 / text #7a3590
#   Identity      burnt   fill #fef3e8 / stroke #c9622e / text #9a4a22
#                 orange  (the enterprise's identity resolver)
#   Person        neutral fill #f0f0f0 / stroke #1c2024 / text #1c2024
#   Boundary and  grey    fill #ffffff / stroke #8c93a3 / text #5f6670
#     placeholder
# Text colors are darkened stroke hues that clear WCAG AA (4.5:1) on the
# fills. Edges take the color of the element that initiates them.
###############################################################################

classes: {
  # C4 element box: a bold name row over a "[Type] + description" row.
  # In a grid, grid-gap doubles as inner padding.
  box: {
    grid-rows: 2
    grid-gap: 12
    vertical-gap: 0
  }
  row-name: {
    width: 290
    height: 44
    style: {fill: transparent; stroke: transparent; font-size: 28; bold: true}
  }
  row-body: {
    width: 290
    style: {fill: transparent; stroke: transparent; font-size: 24; bold: false}
  }
  # Narrower rows for the cells inside the DecisionLedger boundary
  narrow: {width: 250}

  domain: {style: {fill: "#e8eef9"; stroke: "#5b6abf"; stroke-width: 3; border-radius: 16}}
  container: {style: {fill: "#e8f5f3"; stroke: "#0d9488"; stroke-width: 3; border-radius: 16}}
  datastore: {shape: cylinder; style: {fill: "#fbf3e6"; stroke: "#8c6d3f"; stroke-width: 3}}
  state: {shape: cylinder; style: {fill: "#e8f5f5"; stroke: "#2e8b8b"; stroke-width: 3}}
  llm: {style: {fill: "#f5e8f5"; stroke: "#b45dc9"; stroke-width: 3; border-radius: 16}}
  identity: {style: {fill: "#fef3e8"; stroke: "#c9622e"; stroke-width: 3; border-radius: 16}}
  person: {shape: c4-person; style: {fill: "#f0f0f0"; stroke: "#1c2024"; stroke-width: 3}}
  placeholder: {style: {fill: "#ffffff"; stroke: "#8c93a3"; stroke-width: 2; stroke-dash: 4; border-radius: 16}}
  boundary: {style: {fill: transparent; stroke: "#8c93a3"; stroke-width: 2; stroke-dash: 4; border-radius: 12; font-size: 28; font-color: "#5f6670"}}
  system-boundary: {style: {fill: transparent; stroke: "#0d9488"; stroke-width: 2; stroke-dash: 4; border-radius: 12; font-size: 28; font-color: "#0b6e65"}}
  invisible: {style: {fill: transparent; stroke: transparent}}
  # Padding-free wrapper that keeps a shape at its natural size in a grid cell
  wrapper: {
    grid-gap: 0
    style: {fill: transparent; stroke: transparent}
  }

  ink-domain: {style.font-color: "#3f4b96"}
  ink-framework: {style.font-color: "#0b6e65"}
  ink-datastore: {style.font-color: "#6e552f"}
  ink-state: {style.font-color: "#1f6b6b"}
  ink-llm: {style.font-color: "#7a3590"}
  ink-identity: {style.font-color: "#9a4a22"}
  ink-person: {style.font-color: "#1c2024"}
  ink-placeholder: {style.font-color: "#5f6670"}

  from-domain: {style: {stroke: "#5b6abf"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#3f4b96"; italic: false}}
  from-framework: {style: {stroke: "#0d9488"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#0b6e65"; italic: false}}
  from-person: {style: {stroke: "#1c2024"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#1c2024"; italic: false}}
  from-illustrative: {style: {stroke: "#8c93a3"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#5f6670"; italic: false}}
}

###############################################################################
# Upper band: title and the callers (reasoners and the MCP server)
###############################################################################

upper: "" {
  near: top-center
  grid-rows: 3
  # No side padding, so the band is no wider than the caller row
  grid-gap: 0
  vertical-gap: 24
  style: {fill: transparent; stroke: transparent}

  title: "Containers — DecisionLedger" {
    height: 48
    style: {fill: transparent; stroke: transparent; font-size: 34; bold: true; font-color: "#1c2024"}
  }

  callers: "" {
    class: wrapper
    grid-columns: 3
    horizontal-gap: 28

    # Account Takeover's service and the Redis it owns
    ato: "Account Takeover (reasoners/account_takeover)" {
      class: boundary
      grid-columns: 2
      grid-gap: 20
      horizontal-gap: 28

      redis: "" {
        class: [box; state]
        n: "Redis" {class: [row-name; ink-state; narrow]}
        b: "[Database: Redis 7]\n\nATO's feature windows,\ndedup store, and\nlogin-event stream" {class: [row-body; ink-state; narrow]}
      }
      svc: "" {
        class: [box; domain]
        n: "ATO Service" {class: [row-name; ink-domain]}
        b: "[Container: Python,\nFastAPI, port 8001]\n\nScores logins and submits\nthem; runs the ledger in\nprocess (LocalClient) unless\nATO_LEDGER_URL is set" {class: [row-body; ink-domain]}
      }
    }

    # Receipts flow back to the callers through this cell
    returns: "Receipt:\nfinal action\n+ decision ID\n " {
      class: ink-framework
      width: 160
      label.near: bottom-center
      style: {fill: transparent; stroke: transparent; font-size: 24; bold: false}
    }

    agents: "Agent Reasoners" {
      class: boundary
      grid-columns: 2
      grid-gap: 20
      horizontal-gap: 28

      mcp: "" {
        class: [box; container]
        n: "MCP Server" {class: [row-name; ink-framework; narrow]}
        b: "[Container: Python,\ndecisionledger-mcp]\n\nSix ledger tools\nover stdio\n(JSON-RPC 2.0)" {class: [row-body; ink-framework; narrow]}
      }
      agent: "" {
        class: [box; placeholder]
        n: "Agent Reasoner" {class: [row-name; ink-placeholder; narrow]}
        b: "[Software System]\n\nAn LLM agent that\nrecords or gates\nits decisions" {class: [row-body; ink-placeholder; narrow]}
      }
    }
  }

  # Vertical room for the caller edges and their labels
  spacer: "" {
    height: 170
    class: invisible
  }
}

###############################################################################
# Main row: analyst | DecisionLedger | LLM over identity resolver
# (declared in grid order)
###############################################################################

side-l: "" {
  class: wrapper
  grid-rows: 2
  # Centers the analyst on the Ledger API
  drop: "" {width: 254; height: 60; class: invisible}
  analyst: "" {
    class: [box; person]
    grid-rows: 3
    # Keeps the analyst edge on the body's side rather than the head
    head: "" {width: 230; height: 40; class: invisible}
    n: "Decision Analyst" {class: [row-name; ink-person]; width: 230}
    b: "[Person]\n\nData, risk, or audit\nanalyst who reviews\nbusiness decisions" {class: [row-body; ink-person]; width: 230}
  }
}

# The label starts with two U+00A0 no-break spaces and ends with a blank
# line; both pad it away from the dashed corner (d2 has no escape for them)
dl: "  DecisionLedger [Software System]\n " {
  class: system-boundary
  # Bottom-left keeps the label clear of the caller edges entering at the top
  label.near: bottom-left
  grid-rows: 2
  grid-columns: 3
  grid-gap: 28
  horizontal-gap: 56
  vertical-gap: 110

  # Empty upper-left cell: room for the analyst edge and its label
  gap-l: "" {width: 120; class: invisible}
  api: "" {
    class: [box; container]
    n: "Ledger API" {class: [row-name; ink-framework; narrow]}
    b: "[Container: Python,\nFastAPI]\n\nServes /api/v1:\nvalidates each\nsubmission, resolves\nits subject, runs the\ngate plugins, enforces,\nwrites the bundle" {class: [row-body; ink-framework; narrow]}
  }
  # Empty upper-right cell: the LLM and resolver edges leave through it
  gap-r: "" {width: 250; class: invisible}

  gap-b: "" {width: 120; class: invisible}
  pg: "" {
    class: [box; datastore]
    n: "PostgreSQL" {class: [row-name; ink-datastore; narrow]}
    b: "[Database: Postgres 16]\n\nSchema decisionledger:\nbundles, registrations,\nresolution attempts,\nentity journal and\nmembership" {class: [row-body; ink-datastore; narrow]}
  }

  # Gate-owned infrastructure: the framework owns none of it
  gate: "RAG Policy Gate stores (gates/policy_rag)" {
    class: boundary
    grid-columns: 2
    grid-gap: 20
    horizontal-gap: 24

    es: "" {
      class: [box; datastore]
      n: "Elasticsearch" {class: [row-name; ink-datastore; narrow]}
      b: "[Database:\nElasticsearch 8.13]\n\nBM25 index of\npolicy chunks" {class: [row-body; ink-datastore; narrow]}
    }
    vec: "" {
      class: [box; datastore]
      n: "policy_rag" {class: [row-name; ink-datastore; narrow]}
      b: "[Schema: pgvector,\non the same\nPostgres server]\n\nDense policy chunks" {class: [row-body; ink-datastore; narrow]}
    }
  }
}

side-r: "" {
  class: wrapper
  grid-rows: 4
  # Puts the LLM level with the Ledger API
  lift: "" {width: 290; height: 30; class: invisible}
  llm: "" {
    class: [box; llm]
    n: "LLM Service" {class: [row-name; ink-llm]}
    b: "[Software System: OpenAI]\n\nRecommends a verdict to\nthe RAG policy gate for\nambiguous cases" {class: [row-body; ink-llm]}
  }
  # Drops the resolver to the gate-store row
  sink: "" {width: 290; height: 60; class: invisible}
  resolver: "" {
    class: [box; identity]
    n: "Identity Resolver" {class: [row-name; ink-identity]}
    b: "[Plugin: installed by\nthe enterprise]\n\nMaps a native subject to\nthe enterprise's subject;\nthe passthrough when\nnone is installed" {class: [row-body; ink-identity]}
  }
}

###############################################################################
# Relationships
###############################################################################

upper.callers.ato.svc -> dl.api: "Submits decisions\n[HTTP/JSON, or\nthe ledger in\nits own process]\n " {class: from-domain}
upper.callers.ato.svc -> upper.callers.ato.redis: "" {class: from-domain}
upper.callers.agents.agent -> upper.callers.agents.mcp: "" {class: from-illustrative}
upper.callers.agents.mcp -> dl.api: "Tool calls\n[HTTP/JSON]\n " {class: from-framework}
dl.api -> upper.callers.returns: "" {class: from-framework}

side-l.analyst -> dl.api: "Reads, replays,\nand resolves\ndecisions\n[HTTP/JSON]" {class: from-person}

dl.api -> side-r.llm: "RAG gate:\nprompts, verdicts\n[HTTPS]" {class: from-framework}
dl.api -> side-r.resolver: "Resolves\neach subject\n[in process]\n " {class: from-framework}

dl.api -> dl.pg: "Bundles, journals\n[SQL]" {class: from-framework}
dl.api -> dl.gate: "RAG gate: BM25\n[HTTP], vectors\n[SQL]" {class: from-framework}
