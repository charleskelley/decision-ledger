###############################################################################
# DecisionLedger — C4 Level 3: Pipeline Components
#
# Zooms into the Decision Pipeline container (see containers.d2).
# Each box is a component: a grouping of related functionality behind a
# well-defined interface. The Domain Layer / Framework Layer boundary marks
# the single handoff point — build_observation() in the Reasoner Assembler.
#
# Render:  d2 --theme 0 --layout elk components.d2 ../../assets/diagrams/components.svg
# Ref:     docs/design/architecture.md, docs/design/reasoner-handoff.md
###############################################################################

title: |md
  # DecisionLedger — Pipeline Components
| {near: top-center}

direction: down

###############################################################################
# External actors
###############################################################################

ingestion: Ingestion Consumer {
  style.fill: "#dae8fc"
  style.stroke: "#6c8ebf"
  tooltip: "Upstream container: reads Redis Streams, validates LoginEvent schema, enforces bounded lateness, deduplicates. Delivers a clean LoginEvent to the pipeline."
}

decision_analyst: Decision Analyst {
  shape: person
  style.fill: "#dae8fc"
  style.stroke: "#6c8ebf"
  tooltip: "Inspects Decision Bundles persisted in PostgreSQL. Reads bundle records directly to review decisions, citations, and enforcement outcomes."
}

###############################################################################
# Decision Pipeline container
###############################################################################

pipeline: Decision Pipeline {
  style.fill: "#f9f9f9"
  style.stroke: "#82b366"
  style.stroke-width: 2

  ###########################################################################
  # Domain Layer — ATO Reasoner (reasoner/)
  # Pure Python: no infra dependencies. Owns observation and feature types.
  ###########################################################################

  domain: Domain Layer (ATO Reasoner) {
    style.fill: "#eaf3fb"
    style.stroke: "#6c8ebf"
    style.stroke-width: 1

    feature_engine: Feature Engine {
      style.fill: "#dae8fc"
      style.stroke: "#6c8ebf"
      tooltip: "Computes AtoFeatureVector via sliding-window aggregations over per-user event history (velocity, geo-shift, device novelty, credential failure rate). Reads and writes window state in Redis. app/features/"
    }

    redis: Redis {
      shape: cylinder
      style.fill: "#fff2cc"
      style.stroke: "#d6b656"
      tooltip: "Sliding-window feature state: per-user hashes and sorted sets. TTL-managed. Scoped to the domain layer — simulates real-time event stream state for the Feature Engine; not shared with the framework layer."
    }

    scorer: ATO Scorer {
      style.fill: "#dae8fc"
      style.stroke: "#6c8ebf"
      tooltip: "XGBoost classifier: consumes AtoFeatureVector, produces ScorerOutput (risk_score ∈ [0,1], GateRouting decision, top-k SHAP signals). Trained on heuristic labels — triages into confidence bands, not fraud detection. app/scorer/"
    }

    assembler: Reasoner Assembler {
      style.fill: "#6c8ebf"
      style.stroke: "#6c8ebf"
      style.font-color: "#ffffff"
      tooltip: "build_observation(): the only function crossing the domain → framework boundary. Translates (LoginEvent, AtoFeatureVector, ScorerOutput) into (ReasonerContext + GateContext + FastPathRecord). reasoner/account_takeover/assembler.py"
    }

    feature_engine -> redis: "reads/writes\nsliding-window state" {
      style.stroke: "#d6b656"
    }
    feature_engine -> scorer: "AtoFeatureVector"
    scorer -> assembler: "ScorerOutput"
  }

  ###########################################################################
  # Framework Layer — DecisionLedger (core/ + app/)
  ###########################################################################

  routing: Route? {
    shape: diamond
    style.fill: "#82b366"
    style.stroke: "#82b366"
    style.font-color: "#ffffff"
    tooltip: "Inspects observation.routing (GateRouting enum). FAST_PATH_ALLOW if risk_score < 0.20; FAST_PATH_BLOCK if risk_score > 0.85; ROUTE_TO_GATE otherwise."
  }

  retrieval: Retrieval Engine {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Three-stage hybrid RAG over the policy corpus. dense_search (pgvector HNSW cosine) + sparse_search (ES BM25) → rrf_fuse (Reciprocal Rank Fusion k=60) → rerank (cross-encoder; latency-budget bypass falls back to RRF-only). Filters: jurisdictions applied to both stores; risk_tier to pgvector only. app/retrieval/"
  }

  fast_path: Fast Path {
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    tooltip: "Bypasses live LLM invocation. Enforces ALLOW or BLOCK directly from the scorer's routing decision. GateContext preserved in the bundle for retrospective shadow evaluation. No retrieval cost."
  }

  policy_gate: Policy Gate {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Resolves prompt template from YamlPromptRegistry via GateContext.prompt_template_id (immutable — never modified after creation). Renders template with domain-supplied template_vars and retrieved snippets. Invokes OpenAI GPT-4o with structured output schema. Produces PolicyGateOutput (action + citations). app/policy_gate/"
  }

  enforcement: Enforcement Engine {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Deterministic, rule-based action resolution. Priority: HOLD > BLOCK > CHALLENGE > ALLOW. Schema-validation failure always routes to HOLD. Re-executable against cached PolicyGateOutput for replay — no LLM re-invocation. app/enforcement/"
  }

  audit: Audit Engine {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Assembles DecisionBundle from all pipeline intermediates: raw event, ReasonerContext, GateContext, rendered prompt, LLM response, enforcement decision, retrieval_path. Persists to PostgreSQL. Replay re-executes enforcement against the cached bundle state. app/audit/"
  }

  ###########################################################################
  # Internal flows
  ###########################################################################

  domain.assembler -> routing: "Observation\n(ReasonerContext + GateContext + FastPathRecord)"

  routing -> retrieval: "ROUTE_TO_GATE" {
    style.stroke: "#82b366"
  }
  routing -> fast_path: "FAST_PATH_ALLOW\nFAST_PATH_BLOCK" {
    style.stroke: "#d6b656"
  }

  retrieval -> policy_gate: "list[PolicySnippet]"
  policy_gate -> enforcement: "PolicyGateOutput"
  fast_path -> enforcement: "fast-path action"
  enforcement -> audit: "EnforcementDecision"
}

###############################################################################
# External datastores (framework layer)
###############################################################################

postgres: PostgreSQL {
  shape: cylinder
  style.fill: "#fff2cc"
  style.stroke: "#d6b656"
  tooltip: "pgvector HNSW index for dense policy retrieval (384-dim, all-MiniLM-L6-v2). Audit store for persisted Decision Bundles."
}

elasticsearch: Elasticsearch {
  shape: cylinder
  style.fill: "#fff2cc"
  style.stroke: "#d6b656"
  tooltip: "BM25 sparse index over the policy corpus. Jurisdiction and version filters applied at query time."
}

openai: OpenAI API {
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
  tooltip: "GPT-4o LLM inference. Receives structured prompt; returns JSON conforming to PolicyGateOutput schema."
}

###############################################################################
# External relationships
# Edges attach at the domain subgroup boundary to avoid ELK using external
# targets as placement anchors for internal nodes.
###############################################################################

ingestion -> pipeline.domain: "validated LoginEvent" {
  style.stroke: "#6c8ebf"
}

decision_analyst -> postgres: "reads Decision Bundles\n(inspection + replay)" {
  style.stroke: "#6c8ebf"
  style.stroke-dash: 4
}

pipeline.retrieval -> postgres: "HNSW cosine search\n(jurisdictions + risk_tier)" {
  style.stroke: "#d6b656"
}

pipeline.retrieval -> elasticsearch: "BM25 search\n(jurisdictions)" {
  style.stroke: "#d6b656"
}

pipeline.policy_gate -> openai: "structured policy gate prompt\nreceives JSON output" {
  style.stroke: "#666666"
  style.stroke-dash: 4
}

pipeline.audit -> postgres: "persists DecisionBundle\nreads bundle for replay" {
  style.stroke: "#d6b656"
}
