###############################################################################
# DecisionLedger — C4 Level 2: Containers
#
# Inside the DecisionLedger boundary: the containers that must be running for
# the system to work. One long-running process (the Decision API) and three
# datastores. Offline tools (corpus loader, eval harness, scorer trainer,
# scenario generator, baseline capture) run on demand and are left out, per
# the C4 container definition; see the caption in docs/design/architecture.md.
#
# - People and external systems are the L1 elements, with L1's text.
#   Account Takeover is the shipped reference reasoner; its router and
#   pipeline are mounted into the Decision API and hand observations to the
#   framework in-process. The other reasoners are illustrative (grey edges).
# - The LLM or ML service is OpenAI GPT-4o at runtime (named in the caption).
#
# Layout: the reasoner band is pinned above everything with
# `near: top-center`, as in system-context.d2. The rest is a three-column
# grid: analyst, the DecisionLedger boundary, LLM. Grid cells stretch their
# shapes, so the analyst and LLM sit in padding-free two-row wrapper grids
# whose invisible top spacer sets their height. The right spacer (`lift`)
# centers the LLM on the Decision API so that edge stays horizontal: lift =
# API center - LLM height / 2, measured from the boundary's top. Recompute it
# when the API or LLM text changes line count. Inside the boundary, a 3x2
# grid puts the API over the middle datastore, with empty cells either side.
#
# Edge labels: d2 masks an edge only behind its label's text box. Multi-line
# labels keep the lines an edge crosses shorter than their widest line, and
# trailing " " lines extend the mask on the hand-off and return labels, so no
# dash touches the text.
#
# Sources (code paths for maintainers; nothing here renders):
#   Decision API   app/main.py (lifespan, routes), app/decide.py,
#                  reasoner/account_takeover/api.py (mounted router),
#                  reasoner/account_takeover/pipeline.py (in-process hand-off)
#   Redis          reasoner/account_takeover/feature_service.py
#   PostgreSQL     infra/postgres/02_tables.sql, app/audit/store.py,
#                  app/retrieval/retriever.py
#   Elasticsearch  infra/elasticsearch/policy-chunks.json,
#                  app/retrieval/retriever.py
#   LLM            app/llm/openai.py, app/gate/policy/gate.py
#   Tech tags      docker-compose.yml (image versions)
#
# Render:  d2 --theme 0 --layout elk containers.d2 ../../assets/diagrams/containers.svg
# Ref:     docs/design/architecture.md
###############################################################################

vars: {
  # Small pad (siblings use the default 100) maximizes scale at column width
  d2-config: {pad: 16}
}

# Analyst | DecisionLedger | LLM
grid-columns: 3
horizontal-gap: 24

###############################################################################
# Palette (kept consistent across the diagram set)
#   Domain        indigo  fill #e8eef9 / stroke #5b6abf / text #3f4b96
#   Framework     teal    fill #e8f5f3 / stroke #0d9488 / text #0b6e65
#   Datastore     ochre   fill #fbf3e6 / stroke #8c6d3f / text #6e552f
#   State store   cyan    fill #e8f5f5 / stroke #2e8b8b / text #1f6b6b
#   LLM or ML     violet  fill #f5e8f5 / stroke #b45dc9 / text #7a3590
#   Person        neutral fill #f0f0f0 / stroke #1c2024 / text #1c2024
#   Boundary and  grey    fill #ffffff / stroke #8c93a3 / text #5f6670
#     placeholder
# Text colors are darkened stroke hues that clear WCAG AA (4.5:1) on the
# fills. Edges take the color of the element that initiates them.
###############################################################################

classes: {
  # C4 element box: a bold name row over a "[Type] + description" row.
  # In a grid, grid-gap doubles as inner padding.
  box: {
    grid-rows: 2
    grid-gap: 12
    vertical-gap: 0
  }
  row-name: {
    width: 310
    height: 44
    style: {fill: transparent; stroke: transparent; font-size: 28; bold: true}
  }
  row-body: {
    width: 310
    style: {fill: transparent; stroke: transparent; font-size: 24; bold: false}
  }
  # Narrower rows for the cells inside the DecisionLedger boundary
  narrow: {width: 230}

  domain: {style: {fill: "#e8eef9"; stroke: "#5b6abf"; stroke-width: 3; border-radius: 16}}
  container: {style: {fill: "#e8f5f3"; stroke: "#0d9488"; stroke-width: 3; border-radius: 16}}
  datastore: {shape: cylinder; style: {fill: "#fbf3e6"; stroke: "#8c6d3f"; stroke-width: 3}}
  state: {shape: cylinder; style: {fill: "#e8f5f5"; stroke: "#2e8b8b"; stroke-width: 3}}
  llm: {style: {fill: "#f5e8f5"; stroke: "#b45dc9"; stroke-width: 3; border-radius: 16}}
  person: {shape: c4-person; style: {fill: "#f0f0f0"; stroke: "#1c2024"; stroke-width: 3}}
  placeholder: {style: {fill: "#ffffff"; stroke: "#8c93a3"; stroke-width: 2; stroke-dash: 4; border-radius: 16}}
  boundary: {style: {fill: transparent; stroke: "#8c93a3"; stroke-width: 2; stroke-dash: 4; border-radius: 12; font-size: 28; font-color: "#5f6670"}}
  system-boundary: {style: {fill: transparent; stroke: "#0d9488"; stroke-width: 2; stroke-dash: 4; border-radius: 12; font-size: 28; font-color: "#0b6e65"}}
  invisible: {style: {fill: transparent; stroke: transparent}}
  # Padding-free wrapper that keeps a shape at its natural size in a grid cell
  wrapper: {
    grid-rows: 2
    grid-gap: 0
    style: {fill: transparent; stroke: transparent}
  }

  ink-domain: {style.font-color: "#3f4b96"}
  ink-framework: {style.font-color: "#0b6e65"}
  ink-datastore: {style.font-color: "#6e552f"}
  ink-state: {style.font-color: "#1f6b6b"}
  ink-llm: {style.font-color: "#7a3590"}
  ink-person: {style.font-color: "#1c2024"}
  ink-placeholder: {style.font-color: "#5f6670"}

  from-domain: {style: {stroke: "#5b6abf"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#3f4b96"; italic: false}}
  from-framework: {style: {stroke: "#0d9488"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#0b6e65"; italic: false}}
  from-person: {style: {stroke: "#1c2024"; stroke-width: 3; stroke-dash: 5; font-size: 24; font-color: "#1c2024"; italic: false}}
  # Illustrative reasoners: unlabeled grey edges, no code behind them yet
  from-illustrative: {style: {stroke: "#8c93a3"; stroke-width: 2; stroke-dash: 5}}
}

###############################################################################
# Upper band: title and the domain reasoner group (same cards as L1)
###############################################################################

upper: "" {
  near: top-center
  grid-rows: 3
  # No side padding, so the band is no wider than the reasoner row
  grid-gap: 0
  vertical-gap: 24
  style: {fill: transparent; stroke: transparent}

  title: "Containers — DecisionLedger" {
    height: 48
    style: {fill: transparent; stroke: transparent; font-size: 34; bold: true; font-color: "#1c2024"}
  }

  reasoners: "Decision Domain Reasoners" {
    class: boundary
    grid-columns: 5
    grid-gap: 20
    horizontal-gap: 28

    ato: "" {
      class: [box; domain]
      n: "Account Takeover" {class: [row-name; ink-domain]}
      b: "[Software System]\n\nScores login attempts, flags\nclear-cut ones, and collects\ncontext for ambiguous cases" {class: [row-body; ink-domain]}
    }

    clv: "" {
      class: [box; domain]
      n: "Customer Lifetime Value" {class: [row-name; ink-domain]}
      b: "[ML Model]\n\nEstimates customer lifetime\nvalue in batch runs and\nflags retention candidates" {class: [row-body; ink-domain]}
    }

    # Final actions flow back into the reasoner group through this cell
    returns: "Final\naction +\ndecision ID\n[in-process]\n " {
      class: ink-framework
      width: 120
      label.near: bottom-center
      style: {fill: transparent; stroke: transparent; font-size: 24; bold: false}
    }

    cm: "" {
      class: [box; domain]
      n: "Content Moderation" {class: [row-name; ink-domain]}
      b: "[Software System]\n\nScreens forum posts, flags\nclear-cut violations, and\ncollects review context" {class: [row-body; ink-domain]}
    }

    next: "" {
      class: [box; placeholder]
      n: "+ Next Reasoner" {class: [row-name; ink-placeholder]}
      b: "[Software System]\n\nPlugs into the same\nobservation contract with\nno framework changes" {class: [row-body; ink-placeholder]}
    }
  }

  # Vertical room for the fan of reasoner edges and their labels
  spacer: "" {
    height: 150
    class: invisible
  }
}

###############################################################################
# Main row: analyst | DecisionLedger | LLM or ML service
# (declared in grid order)
###############################################################################

side-l: "" {
  class: wrapper
  # Centers the analyst on the Decision API: API center - person height / 2
  drop: "" {width: 284; height: 108; class: invisible}
  analyst: "" {
    class: [box; person]
    grid-rows: 3
    # Keeps the analyst edge on the body's side rather than the head
    head: "" {width: 230; height: 40; class: invisible}
    n: "Decision Analyst" {class: [row-name; ink-person]; width: 230}
    b: "[Person]\n\nData, risk, or audit\nanalyst who reviews\nbusiness decisions" {class: [row-body; ink-person]; width: 230}
  }
}

# The label starts with two U+00A0 no-break spaces and ends with a blank
# line; both pad it away from the dashed corner (d2 has no escape for them)
dl: "  DecisionLedger [Software System]\n " {
  class: system-boundary
  # Bottom-left keeps the label clear of the reasoner fan entering at the top
  label.near: bottom-left
  grid-rows: 2
  grid-columns: 3
  grid-gap: 28
  horizontal-gap: 48
  vertical-gap: 120

  gap-l: "" {class: invisible}
  api: "" {
    class: [box; container]
    n: "Decision API" {class: [row-name; ink-framework; narrow]}
    b: "[Container: Python,\nFastAPI]\n\nServes Account\nTakeover at POST\n/api/v1/ato/decisions.\nGate-routed cases get\nretrieval and the\nLLM gate; every\ndecision is enforced\nand audited" {class: [row-body; ink-framework; narrow]}
  }
  gap-r: "" {class: invisible}

  redis: "" {
    class: [box; state]
    n: "Redis" {class: [row-name; ink-state; narrow]}
    b: "[Database: Redis 7]\n\nAccount Takeover\nsliding-window\nfeature state" {class: [row-body; ink-state; narrow]}
  }
  pg: "" {
    class: [box; datastore]
    n: "PostgreSQL" {class: [row-name; ink-datastore; narrow]}
    b: "[Database: Postgres\n16 + pgvector]\n\nPolicy vectors and\nthe decision ledger" {class: [row-body; ink-datastore; narrow]}
  }
  es: "" {
    class: [box; datastore]
    n: "Elasticsearch" {class: [row-name; ink-datastore; narrow]}
    b: "[Database:\nElasticsearch 8.13]\n\nBM25 index of\npolicy chunks" {class: [row-body; ink-datastore; narrow]}
  }
}

side-r: "" {
  class: wrapper
  # Centers the LLM on the Decision API (see Layout above)
  lift: "" {width: 294; height: 192; class: invisible}
  llm: "" {
    class: [box; llm]
    # 270 rather than 310 keeps the right column narrow; text matches L1
    n: "LLM or ML Service" {class: [row-name; ink-llm]; width: 270}
    b: "[Software System]\n\nPowers the decision gate:\nrecommends a verdict for\nambiguous cases" {class: [row-body; ink-llm]; width: 270}
  }
}

###############################################################################
# Relationships
###############################################################################

upper.reasoners.ato -> dl.api: "Hands over each\nobservation\n[in-process]\n " {class: from-domain}
upper.reasoners.clv -> dl.api: "" {class: from-illustrative}
upper.reasoners.cm -> dl.api: "" {class: from-illustrative}
dl.api -> upper.reasoners.returns: "" {class: from-framework}

side-l.analyst -> dl.api: "Fetches bundles and\nreplays decisions\n[HTTP/JSON]" {class: from-person}
dl.api -> side-r.llm: "Gate-routed cases:\nsends prompts,\ngets verdicts\n[HTTPS]" {class: from-framework}

dl.api -> dl.redis: "Reads, writes\nfeatures\n[RESP]" {class: from-framework}
dl.api -> dl.pg: "Vector search,\nbundles [SQL]" {class: from-framework}
dl.api -> dl.es: "BM25 search\n[HTTP]" {class: from-framework}
