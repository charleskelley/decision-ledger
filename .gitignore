# ============================================================================
# DecisionLedger .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# Local working directory to store all project related files not to be tracked
# ----------------------------------------------------------------------------
zoo/

# ----------------------------------------------------------------------------
# Personal LLM-maintained knowledge base
# See knowledge/CLAUDE.md (if present) for its operating schema.
# Gitignored intentionally — KB is personal, upstream of the project.
# ----------------------------------------------------------------------------
knowledge/

# ----------------------------------------------------------------------------
# Claude Code
# ----------------------------------------------------------------------------
.claude/settings.local.json

# ----------------------------------------------------------------------------
# uv
# NOTE: uv.lock is deliberately NOT ignored — it is committed for reproducibility.
# ----------------------------------------------------------------------------
.uv_cache/

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt
.Python
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Virtual environments
.venv/
venv/
ENV/
env/
.env

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# mypy / pyright / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
pyrightconfig.json

# Ruff
.ruff_cache/

# ----------------------------------------------------------------------------
# Project-specific
# ----------------------------------------------------------------------------

# Secrets and credentials — NEVER commit these
.env.local
.env.production
.env.*.local
secrets/
*.pem
*.key

# OpenAI / LLM API keys
.openai_api_key

# Model artifacts (large binary files)
models/*.bin
models/*.pkl
models/*.joblib
models/*.xgb
*.onnx

# Embedding caches
embeddings_cache/
.sentence_transformers/

# Scenario generator output (regenerable)
scen/output/
scen/*.jsonl

# Evaluation run artifacts (regenerable)
eval/results/
eval/reports/

# Policy corpus embeddings (regenerable from source docs)
data/vectors/
data/index/

# Decision Bundle exports (local dev only)
bundles_export/

# Terraform state — contains secrets, never commit
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform/
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/.terraform.lock.hcl

# Docker
docker-compose.override.yml
docker-compose.override.yaml

# Redis dumps
dump.rdb

# PostgreSQL data volumes
pgdata/
pg_data/

# Elasticsearch data
esdata/
es_data/

# ----------------------------------------------------------------------------
# TMUX
# ----------------------------------------------------------------------------
.tmux-layout.sh

