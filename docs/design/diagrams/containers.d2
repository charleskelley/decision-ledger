###############################################################################
# DecisionLedger — C4 Level 2: Containers
#
# Two system groups are shown:
#   - ATO Reasoner (account_takeover): external to DecisionLedger; submits
#     Observations (ReasonerContext + GateContext) via the handoff contract.
#   - DecisionLedger: the governed decision framework that receives Observations
#     and produces enforced decisions with full audit.
#
# Render:  d2 --theme 0 --layout elk containers.d2 ../../assets/diagrams/containers.svg
# Ref:     docs/design/architecture.md, docs/design/reasoner-handoff.md
###############################################################################

title: |md
  # DecisionLedger — Container Diagram
| {near: top-center}

direction: down

###############################################################################
# External actors
###############################################################################

security_analyst: Decision Analyst {
  shape: person
  style.fill: "#dae8fc"
  style.stroke: "#6c8ebf"
  tooltip: "Inspects persisted Decision Bundles in PostgreSQL; runs the eval suite to review retrieval quality, faithfulness, and decision consistency."
}

openai: OpenAI API {
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
  tooltip: "LLM inference for the policy gate."
}

###############################################################################
# ATO Reasoner — external; uses DecisionLedger via the Observation contract
###############################################################################

ato_reasoner: ATO Reasoner (Account Takeover) {
  style.fill: "#eff4fb"
  style.stroke: "#6c8ebf"
  style.stroke-width: 2

  scenario_generator: Scenario Generator {
    shape: hexagon
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    tooltip: "Generates synthetic LoginEvent streams across 8 attack and benign scenarios; publishes to Redis Streams. Python 3.11 CLI, generator/."
  }

  ingestion: Ingestion Consumer {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    tooltip: "Reads Redis Streams; validates LoginEvent schema, enforces bounded lateness, deduplicates. Routes failures to DLQ. Async event path. app/ingestion/."
  }

  decision_api: Decision API {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    tooltip: "HTTP entry point: accepts LoginEvent, runs Feature Engine → Scorer → Assembler, submits Observation to DecisionLedger pipeline, returns DecisionResponse. FastAPI, app/."
  }

  scenario_generator -> ingestion: "Publishes LoginEvents\n(Redis Streams)"
}

###############################################################################
# DecisionLedger — governed decision framework
###############################################################################

decision_ledger: DecisionLedger {
  style.fill: "#f9f9f9"
  style.stroke: "#82b366"
  style.stroke-width: 2

  ###########################################################################
  # Runtime
  ###########################################################################

  pipeline: Decision Pipeline {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Receives Observation (ReasonerContext + GateContext). Three-stage hybrid RAG → LLM policy gate → deterministic enforcement → audit bundle. app/retrieval + app/policy_gate + app/enforcement + app/audit."
  }

  ###########################################################################
  # Datastores
  ###########################################################################

  postgres: PostgreSQL {
    shape: cylinder
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    tooltip: "pgvector HNSW index for dense policy retrieval (384-dim, all-MiniLM-L6-v2). Audit store for Decision Bundles. PostgreSQL 16 + pgvector."
  }

  elasticsearch: Elasticsearch {
    shape: cylinder
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    tooltip: "BM25 sparse index over the policy corpus with jurisdiction and version filters. Elasticsearch 8.13."
  }

  ###########################################################################
  # Offline tooling
  ###########################################################################

  corpus_builder: Policy Corpus Builder {
    shape: hexagon
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "Offline CLI: chunks policy documents, embeds with all-MiniLM-L6-v2, bulk-inserts into pgvector and Elasticsearch. app/retrieval/."
  }

  eval_harness: Evaluation Harness {
    shape: hexagon
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    tooltip: "5-dimension eval: retrieval quality, faithfulness, decision consistency, citation accuracy, adversarial robustness. eval/."
  }
}

###############################################################################
# Relationships — ATO Reasoner → DecisionLedger
###############################################################################

ato_reasoner.ingestion -> decision_ledger.pipeline: "Observation\n(ReasonerContext + GateContext)" {
  style.stroke: "#6c8ebf"
}

ato_reasoner.decision_api -> decision_ledger.pipeline: "Observation\n(ReasonerContext + GateContext)" {
  style.stroke: "#6c8ebf"
}

decision_ledger.pipeline -> ato_reasoner.decision_api: "EnforcementDecision" {
  style.stroke: "#82b366"
}

###############################################################################
# Relationships — DecisionLedger internal
###############################################################################

decision_ledger.pipeline -> decision_ledger.postgres: "Dense HNSW vector search\nwrites/reads DecisionBundle" {
  style.stroke: "#d6b656"
}

decision_ledger.pipeline -> decision_ledger.elasticsearch: "BM25 policy search\nwith jurisdiction filters" {
  style.stroke: "#d6b656"
}

decision_ledger.pipeline -> openai: "Structured policy gate prompt\nreceives JSON output" {
  style.stroke: "#666666"
  style.stroke-dash: 4
}

decision_ledger.corpus_builder -> decision_ledger.postgres: "Bulk-inserts 384-dim embeddings\ninto pgvector HNSW" {
  style.stroke: "#82b366"
  style.stroke-dash: 4
}

decision_ledger.corpus_builder -> decision_ledger.elasticsearch: "Bulk-indexes policy chunks\nwith metadata" {
  style.stroke: "#82b366"
  style.stroke-dash: 4
}

decision_ledger.eval_harness -> decision_ledger.postgres: "Reads Decision Bundles\nfor consistency and citation checks" {
  style.stroke: "#82b366"
  style.stroke-dash: 4
}

###############################################################################
# Relationships — Decision Analyst (passive)
###############################################################################

security_analyst -> decision_ledger.postgres: "Reads Decision Bundles\n(passive inspection)" {
  style.stroke: "#6c8ebf"
  style.stroke-dash: 4
}

security_analyst -> decision_ledger.eval_harness: "Runs eval suite\nreviews EvalReport" {
  style.stroke: "#6c8ebf"
}
